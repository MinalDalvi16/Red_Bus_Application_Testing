<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="INFO">

    <Properties>
        <Property name="log-path">./logs</Property>
        <Property name="log-pattern">%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n</Property>
    </Properties>

    <Appenders>

        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${log-pattern}"/>
        </Console>

        <!-- Rolling File Appender -->
        <RollingFile
            name="File"
            fileName="${log-path}//Red_Bus_Application_Testing/logs"
            filePattern="${log-path}/automation-%d{MM-dd-yyyy}-%i.log.gz">

            <PatternLayout pattern="${log-pattern}"/>

            <Policies>
                <!-- Create a new log file based on date -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>

                <!-- Create a new log file when size reaches 1 MB -->
                <SizeBasedTriggeringPolicy size="1MB"/>
            </Policies>

            <!-- Keep maximum 10 backup log files -->
            <DefaultRolloverStrategy max="5000"/>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Root Logger -->
        <Root level="INFO">

            <!-- Display logs in Console -->
            <AppenderRef ref="Console"/>

            <!-- Save logs in automation.log -->
            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>